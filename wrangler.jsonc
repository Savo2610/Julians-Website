{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Der Name muss exakt dem Worker-Namen im Cloudflare-Dashboard entsprechen,
  // sonst legt ein Build einen zweiten Worker an.
  "name": "website",
  "compatibility_date": "2026-08-04",

  // Reine statische Seite: kein main, nur der Ordner mit den Dateien.
  "assets": { "directory": "./public" },

  "routes": [
    { "pattern": "veerka.mp", "custom_domain": true },
    { "pattern": "www.veerka.mp", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
