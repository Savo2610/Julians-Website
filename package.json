{
  "name": "kabelsee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wasserski am Kabel rund um eine Insel. Ein kleines 3D-Spiel im Browser mit three.js.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "shots": "node tools/screenshots.mjs",
    "video": "node tools/video.mjs",
    "deploy": "wrangler deploy",
    "preview:worker": "npm run build && wrangler dev"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "vite": "^8.3.1",
    "wrangler": "^4.144.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
