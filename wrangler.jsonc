// kabelsee.veerka.mp. Reine statische Seite wie zeit.veerka.mp: kein
// Worker-Code, nur die gebauten Dateien aus dist/.
//
// Jeder Push auf main wird von Cloudflare Workers Builds gebaut und mit
// `npx wrangler deploy` veroeffentlicht. "build" laesst vorher vite laufen,
// ganz gleich, was im Dashboard als Build-Befehl eingetragen ist – ohne
// dist/ gaebe es nichts hochzuladen.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Muss exakt dem Worker-Namen im Dashboard entsprechen, sonst legt ein
  // Build einen zweiten Worker an.
  "name": "kabelsee",
  "compatibility_date": "2026-09-30",
  "build": { "command": "npm run build", "watch_dir": ["src", "public", "index.html"] },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Custom Domain statt Route: sie legt den DNS-Eintrag selbst an.
  "routes": [
    { "pattern": "kabelsee.veerka.mp", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false
}
